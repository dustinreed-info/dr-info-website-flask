---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Home - Dustin Reed">
  <section class="hero">
    <div class="hero-content">
      <h1>Dustin Reed</h1>
      <p class="subtitle">AI Automation Architect · Senior DevOps & Cloud Engineer</p>
      <p class="hero-description">
        I design AI-driven automation and the platform architecture that runs it. With over a decade
        in enterprise IT and cloud, I bring a DevOps foundation to building agentic AI systems,
        autonomous workflows, and the MLOps/LLMOps pipelines behind them. Currently architecting
        Azure AI and Databricks solutions with automated CI/CD for government cloud environments.
      </p>
      <div class="cta-buttons">
        <a href="/projects/" class="btn btn-primary">
          <i class="fas fa-code"></i>
          View My Work
        </a>
        <a href="/Resume-Reed-Dustin.pdf" class="btn btn-secondary">
          <i class="fas fa-download"></i>
          Download Resume
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">About Me</h2>
        <p class="section-subtitle">
          A journey from early programming experiments to enterprise DevOps solutions
        </p>
      </div>

      <div class="about-content">
        <div class="about-text">
          <p>
            My passion for computing began at a young age, starting with my first application in
            QBasic at age 8 and evolving into creating text-based games on my TI-83 calculator in high
            school. This early curiosity laid the foundation for my career in technology.
          </p>

          <p>
            Today my focus is architecting AI automation: agentic AI platforms, autonomous and
            human-in-the-loop workflows, and LLM/RAG systems built on Databricks and Azure AI. I work
            at the intersection of AI, automation, and cloud architecture, designing how these
            systems are orchestrated, served, and operated in production.
          </p>

          <p>
            That work rests on a strong DevOps foundation. I build the CI/CD and MLOps/LLMOps
            pipelines that take models and AI workflows from experimentation to reliable, observable,
            and secure deployment across cloud platforms, including government cloud environments.
          </p>
        </div>

        <div class="about-highlights">
          <div class="highlight-card">
            <div class="highlight-icon">
              <i class="fas fa-robot"></i>
            </div>
            <h3>AI Automation Architecture</h3>
            <p>Agentic AI, autonomous workflows, LLM/RAG systems, and orchestration design</p>
          </div>

          <div class="highlight-card">
            <div class="highlight-icon">
              <i class="fas fa-infinity"></i>
            </div>
            <h3>MLOps & LLMOps</h3>
            <p>Pipelines for training, evaluation, deployment, model serving, and monitoring</p>
          </div>

          <div class="highlight-card">
            <div class="highlight-icon">
              <i class="fas fa-cloud"></i>
            </div>
            <h3>Cloud Architecture</h3>
            <p>Azure AI, AWS, Databricks, and Infrastructure as Code</p>
          </div>

          <div class="highlight-card">
            <div class="highlight-icon">
              <i class="fas fa-cogs"></i>
            </div>
            <h3>DevOps & SRE</h3>
            <p>CI/CD pipelines, infrastructure automation, monitoring, and reliability</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">AI & Automation Toolkit</h2>
        <p class="section-subtitle">
          Core skills and technologies I architect with
        </p>
      </div>

      <div class="tech-stack">
        <div class="tech-stack-grid">
          <div class="tech-item">
            <i class="fas fa-robot"></i>
            <span>AI Automation</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-brain"></i>
            <span>Agentic AI</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-diagram-project"></i>
            <span>Workflow Orchestration</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-comment-dots"></i>
            <span>LLMs</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-magnifying-glass"></i>
            <span>RAG</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-infinity"></i>
            <span>MLOps / LLMOps</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-sitemap"></i>
            <span>Solution Architecture</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-cloud"></i>
            <span>Cloud Architecture</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-gears"></i>
            <span>Infrastructure Automation</span>
          </div>
          <div class="tech-item">
            <i class="fab fa-python"></i>
            <span>Python</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-bolt"></i>
            <span>Databricks</span>
          </div>
          <div class="tech-item">
            <i class="fab fa-aws"></i>
            <span>Azure AI / AWS AI</span>
          </div>
          <div class="tech-item">
            <i class="fas fa-code-branch"></i>
            <span>CI/CD</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
