# Copy to .env and fill in your values (.env is gitignored)
S3_BUCKET=your-bucket-name
CLOUDFRONT_DIST_ID=<cloudfront-distribution-id>
S3_REGION=us-east-1

# Contact form — AWS Lambda Function URL (baked into the static build)
# Use the dustinreed-specific handler (NOT omniforge's omniforge-contact-handler).
# Get the URL: aws lambda get-function-url-config --function-name dustinreed-contact-handler --region us-east-1
PUBLIC_LAMBDA_ENDPOINT=https://REPLACE_WITH_DUSTINREED_LAMBDA_FUNCTION_URL
